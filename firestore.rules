rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check document ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Candidates collection
    match /candidates/{candidateId} {
      allow read, update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read, update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Evaluations collection
    match /evaluations/{evaluationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
    }

    // Audit logs collection (immutable: create and read only)
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false; // Immutable audit ledger
    }

    // Users profile collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
