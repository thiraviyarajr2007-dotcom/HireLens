# ==============================================================================
# HireLens AI — Environment Configuration Template
# Copy this file to .env before starting the server or frontend.
# NEVER commit real production API keys or service credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Persistence Adapter: 'local' (store.json mutex file) or 'firestore'
STORAGE=local

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: gemini | openai | groq | ollama
# If no provider is configured, HireLens runs in transparent Heuristic Mode.
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Google Gemini Native Endpoint (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Groq (Required if LLM_PROVIDER=groq)
GROQ_API_KEY=

# Custom / Local Ollama base URL (Optional, defaults to http://localhost:11434/api/chat)
LLM_BASE_URL=

# ------------------------------------------------------------------------------
# Firebase Admin & Client Configuration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
# Either a JSON string containing the service account credentials or a local file path
FIREBASE_SERVICE_ACCOUNT_KEY=

# Frontend Vite Settings
VITE_API_URL=http://localhost:5000/api
# Enable sandbox demo recruiter login without Firebase setup: true | false
VITE_DEMO_MODE=true
